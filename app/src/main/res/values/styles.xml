<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">CineCam Pro</string>

    <!-- Premium HUD pass: compact translucent chips, letter-spaced, subtle strokes -->
    <style name="AssistBtn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#B3FFFFFF</item>
        <item name="android:paddingLeft">9dp</item>
        <item name="android:paddingRight">9dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="SliderRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="SliderLabel">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="SliderSeek">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">18dp</item>
    </style>

    <style name="AutoBtn">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/auto_btn_bg</item>
    </style>
</resources>
